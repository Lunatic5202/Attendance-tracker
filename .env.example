# Copy to .env and keep this file private.
ENVIRONMENT=production
# Generate with: python -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# NOTE: never change this after data exists — every stored field is encrypted with it.
ATTENDANCE_MASTER_KEY=replace-with-a-long-random-secret

# --- Storage ---
# Leave DATABASE_URL unset to use SQLite at ATTENDANCE_DB (data/attendance.db).
# Set it to a PostgreSQL connection string to use PostgreSQL instead. Use the
# pooled connection string from your provider (it ends in -pooler), because the
# app keeps a small pool of connections open.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Maximum pooled connections. Keep this low on small free tiers.
# PG_POOL_MAX=5
# Admins use this only; employees never need passwords or accounts.
ADMIN_PASSWORD=replace-with-a-long-random-admin-password
# Exact browser origin(s), comma-separated. Example for same-origin deployment:
ALLOWED_ORIGINS=https://attendance.btprojects.co.in
# Minimum time between face check-in and face check-out (office staff only).
MIN_CHECKOUT_HOURS=4
# Fixed office shift start (HH:MM). Office staff checking in after this are
# recorded as "Late". Field / ground crew are never late — they just log visits.
LATE_AT=09:30
# Gap enforced after each check-in, so the camera cannot record two people
# standing at the kiosk at once. Set to 0 to disable.
CHECKIN_BUFFER_SECONDS=8
# Face recognition: maximum SFace cosine distance for a match. Lower is
# stricter (fewer false accepts, more false rejects). The default 0.363 is the
# calibrated LFW-masked value for the 2021dec SFace model.
FACE_THRESHOLD=0.363
# Minimum gap between the best and second-best match, as a cosine distance.
# When two people are closer than this the scan is rejected as ambiguous
# instead of guessing. 0 disables the safety net.
FACE_MARGIN=0.04
# Face detector: haar (default, no extra model) or yunet (small DNN, better on
# side angles and partial faces). The YuNet model is baked into the Docker
# image; anywhere else it must sit at backend/models/face_detection_yunet_2023mar.onnx
# (or point YUNET_MODEL at it). Missing model -> falls back to Haar with a warning.
FACE_DETECTOR=haar
# Reject scans whose face crop is blurry or badly lit BEFORE matching, with a
# clear on-screen message instead of a silent "not recognised". Set
# FACE_MIN_SHARPNESS=0 to effectively disable the sharpness gate.
FACE_MIN_SHARPNESS=30
# Tolerable face-crop brightness range (0-255) for the same pre-match gate.
# FACE_BRIGHTNESS_MIN=40
# FACE_BRIGHTNESS_MAX=220
# Max stored templates per employee for additive "add sample" enrollment.
# Additions past this are refused, never evicted.
FACE_MAX_TEMPLATES=5
# Additive enrollment skips new embeddings within this cosine distance of an
# already stored pose (same angle/lighting adds no discriminating power).
# FACE_DEDUPE_DISTANCE=0.08
# Minimum detection confidence for the YuNet detector (0-1). Only relevant
# when FACE_DETECTOR=yunet.
# FACE_YUNET_SCORE=0.6
ADMIN_SESSION_TTL=28800
# Public scan endpoint rate limit (per client IP). Admin login is NOT limited.
SCAN_RATE_LIMIT=10
SCAN_RATE_WINDOW=60

# --- Microsoft 365 / OneDrive sync (optional) ---
# App-only access to OneDrive for Business. See README "Microsoft 365 / Excel sync".
# MS_CLIENT_ID=<Entra app (client) ID>
# MS_CLIENT_SECRET=<Entra app client secret>
# MS_TENANT_ID=<Entra directory (tenant) ID>
# MS_DRIVE_UPN=<email of the OneDrive owner that receives the exports>
# Folder inside OneDrive that receives the workbook + backups.
MS_FOLDER=Attendance Tracker
# Excel filename under MS_FOLDER.
MS_EXCEL_FILENAME=Attendance.xlsx
# Daily sync time (UTC, HH:MM). A startup pass also runs once after boot.
MS_SYNC_TIME=23:30
# Number of encrypted backups to keep before pruning old ones.
MS_BACKUP_KEEP=14
# Set to 0 to disable either task independently (default 1 = enabled).
# MS_EXCEL_ENABLED=1
# MS_BACKUP_ENABLED=1
